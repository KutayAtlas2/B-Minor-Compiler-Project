%{
#include "parser.tab.h"   // Generated by Bison
#include <stdlib.h>
#include <string.h>

%}

%option yylineno

%%

"integer"       { return INTEGER; }
"float"         { return FLOAT; }
"boolean"       { return BOOLEAN; }
"char"          { return CHAR; }
"string"        { return STRING; }
"array"         { return ARRAY; }
"void"          { return VOID; }

"if"            { return IF; }
"else"          { return ELSE; }
"while"         { return WHILE; }
"return"        { return RETURN; }
"print"         { return PRINT; }
"function"      { return FUNCTION; }

"true"          { return TRUE; }
"false"         { return FALSE; }

[a-zA-Z_][a-zA-Z0-9_]* {
    yylval.id = strdup(yytext);
    return IDENTIFIER;
}


[0-9]+ {
    yylval.num = atoi(yytext);
    return NUMBER;
}

[0-9]+"."[0-9]+ {
    yylval.fnum = atof(yytext);
    return FLOAT_LITERAL;
}

\'([^'\\\n]|\\.)\'     { yylval.id = strdup(yytext); return CHARACTER_LITERAL; }
\"([^"\\\n]|\\.)*\"    { yylval.id = strdup(yytext); return STRING_LITERAL; }

"+"             { return PLUS; }
"-"             { return MINUS; }
"*"             { return MUL; }
"/"             { return DIV; }
"%"             { return MOD; }
"^"             { return EXPO; }
"="             { return ASSIGN; }
"=="            { return EQ; }
"!="            { return NEQ; }
"<"             { return LT; }
"<="            { return LE; }
">"             { return GT; }
">="            { return GE; }

"&&"            { return AND; }
"||"            { return OR; }
":"             { return COLON; }
"!"             { return NOT; }

";"             { return SEMICOLON; }
","             { return COMMA; }
"("             { return LPAREN; }
")"             { return RPAREN; }
"{"             { return LBRACE; }
"}"             { return RBRACE; }
"["             { return LBRACK; }                
"]"             { return RBRACK; }

[ \t\r\n]+      ;   

"//".*          ;   
"/*"([^*]|\*+[^*/])*\*+"/" ;   

. {
     printf("Unknown character: %s on line %d\n", yytext, yylineno); 
}

%%

int yywrap(void) {
    return 1;
}